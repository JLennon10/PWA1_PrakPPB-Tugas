{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PWA: Run development server",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev", "--", "--host", "127.0.0.1"],
      "windows": { "command": "npm.cmd" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "PWA: Build production",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "windows": { "command": "npm.cmd" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
